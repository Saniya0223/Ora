# Reference for later phases; the health handler needs no environment variables.
# Use an authenticated AWS profile locally and the Lambda execution role in AWS.
# Do not add AWS access keys here.
AWS_REGION=

# Active provider. Groq runs both locally and in Lambda.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b



STUDENT_PROFILE_TABLE=StudentProfile
ACADEMIC_EVENTS_TABLE=AcademicEvents
CLASSROOM_SYNC_STATE_TABLE=ClassroomSyncState
SCHEDULE_BLOCKS_TABLE=ScheduleBlocks
UPLOAD_BUCKET=

# Backend-only values; populate locally or in deployment configuration.
# Never commit actual values or expose them through NEXT_PUBLIC_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
OAUTH_STATE_SECRET=
FRONTEND_URL=http://localhost:3000
DAILY_STUDY_HOURS=4

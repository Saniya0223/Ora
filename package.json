{
  "name": "campusflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "npm run test --workspace @campusflow/backend",
    "test:frontend": "node --test app/tests/frontend.test.cjs",
    "sam:validate": "sam validate --lint --template-file template.yaml",
    "sam:build": "sam build --template-file template.yaml",
    "sam:local": "sam local start-api --port 3001"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "next": "15.5.24",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
